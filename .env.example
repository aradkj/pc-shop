# ---------------------------------------------------------------------------
# Arad Store - environment variables
#
#   cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets. Every value below is a
# development placeholder - change them before deploying anywhere.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL (read by the `postgres` container) --------------------------
POSTGRES_DB=arad_store
POSTGRES_USER=arad_user
# Keep it URL-safe (letters, digits, "-" and "_"): it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-db-password
# Host port published by docker compose (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------------
# Used when the backend runs directly on your machine (host "localhost").
# Inside Docker Compose this value is ignored: compose builds the URL from the
# POSTGRES_* values above and points it at the `postgres` container.
DATABASE_URL=postgresql+psycopg://arad_user:change-me-db-password@localhost:5432/arad_store

# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to start in production with a placeholder or short key.
SECRET_KEY=change-me-use-a-long-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# bcrypt cost factor (4-31). 12 is a sensible default.
BCRYPT_ROUNDS=12

# Optional Cookie & Security settings (defaults: secure in production, lax SameSite)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# ENABLE_HSTS=false

# --- Development seed data (python -m app.seed) -------------------------------
# DEVELOPMENT ONLY. Never reuse these passwords anywhere else.
SEED_ADMIN_PASSWORD=Admin12345!
SEED_CUSTOMER_PASSWORD=Customer12345!
